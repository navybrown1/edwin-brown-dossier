{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/.well-known/appspecific/com.tesla.3p.public-key.pem",
      "destination": "/tesla-public-key.pem"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/appspecific/com.tesla.3p.public-key.pem",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-pem-file"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/api/tesla/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
